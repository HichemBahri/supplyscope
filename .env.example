# ==============================================================
# SupplyScope environment — copy to .env and fill in real values
#   cp .env.example .env
# .env is git-ignored. NEVER commit secrets.
# ==============================================================

# --- PostgreSQL -----------------------------------------------
POSTGRES_USER=supplyscope
POSTGRES_PASSWORD=change_me_to_a_real_password
POSTGRES_DB=supplyscope
POSTGRES_PORT=5432

# --- LLM provider (used from Phase 2 onward) ------------------
# LLM_PROVIDER: anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL_FAST=claude-haiku-4-5
LLM_MODEL_SMART=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
